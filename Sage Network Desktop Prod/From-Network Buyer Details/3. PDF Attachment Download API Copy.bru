  Authorization: Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6IlJVUXlRME0wTWtOQk5rUkJOVGxETXpaQ056VXhPVVUyUkRZNU5EbEJOVVF6T0VSQk1EQXdNQSJ9..ivHvU6_aJrCVnKkjY7jlqT2tlqVFLFJ_wQAgpgewtTfCwnrE6V72W-KPfDeucRP9Zy7HavOmaY4VAhfhG-wVPpz39h7nTbBIpgAIWQ4_rRPBjvOq39kWDggUc4KHVBEXv1tdy--5GMqNaoOALbxYDeb0Lkxa9jpNzakSItzz2EqwnFzJRX_4xpI03gXEeWdx8nt-v2LOo76XZ2My3QjZqup2Cv8bpwJ58aDqM4gIvUQUgE-0iuogbLV0REVn4Lb1Zx0MQYXS7P2A61JpGIeNuneY5Sz13YrIawzReH8viCSN9jKG7PWKNiFII4nffuWX6b1N3kL-uLSNe6QAROPs8Q
}

script:post-response {
  test("Response status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Id is not null and has a size of 36 bits", function () {
    var responseJSON = res.getBody();
    expect(responseJSON.id).to.not.be.null;
    expect(responseJSON.id).to.be.a('string').and.to.have.lengthOf(36);
  });
  var responseJSON = res.getBody();
  test("Attributes contain downloadUrl starting with 'https://'", function () {
    var attributes = responseJSON.attributes;
    expect(attributes).to.have.property('downloadUrl').that.is.a('string').and.to.include('https');
  });
  test("FileName is not blank and has a size of 36 bits", function () {
      var responseJSON = res.getBody();
      expect(responseJSON.attributes.fileName).to.not.be.empty;
      expect(responseJSON.attributes.fileName.length).to.be.equal(36);
  });
  // Test to check that the 'fileExtension' is '.xml'
  test("File extension is '.pdf'", function () {
      var responseJSON = res.getBody();
      expect(responseJSON.attributes.fileExtension).to.equal('.pdf');
  });
  test("Attachment type is 'ObjectPDF'", function () {
      var responseJSON = res.getBody();
      expect(responseJSON.attributes.attachmentType).to.equal('ObjectPDF');
  });
}

settings {
  encodeUrl: true
}

