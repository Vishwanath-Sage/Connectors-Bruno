meta {
  name: GetAttachment UBL
  type: http
  seq: 3
}

get {
  url: {{sageNetworkBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantIdBuyer}}/attachments/{id}?id={{attachmentId}}
  body: none
  auth: inherit
}

params:query {
  id: {{attachmentId}}
}

script:post-response {
  var jsonData = res.getBody();
  bru.setEnvVar("attachmentdownloadUrl", jsonData.attributes.downloadUrl);
}

settings {
  encodeUrl: true
}
