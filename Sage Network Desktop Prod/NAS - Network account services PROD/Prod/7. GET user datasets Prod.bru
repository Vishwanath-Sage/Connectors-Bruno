script:post-response {
  var jsonData = JSON.parse(responseBody);
  
  test("Validate Response", () => {
    const statusCode = expect(res.getStatus()).to.equal(); // Obtain status code
    console.log("Response Status Code:", statusCode);
  
    if (statusCode === 200) {
      // Assertions for successful response
      test("Compare Account ID", () => {
      
        expect(res.getBody().data[0].relationship.account.data.id).to.eq(bru.getEnvVar("AccountId")); // Corrected path Account ID
        console.log("Account ID:", res.getBody().data[0].relationship.account.data.id);
    
      });
      test("Compare Tenant ID", () => {
          expect(res.getBody().data[0].id).to.eq(bru.getEnvVar("TenantId"));
          console.log("Tenant ID:", res.getBody().data[0].id);
      });
      test("Top Level Keys", () => {
          const keys = res.getBody().keys();
          expect(keys).to.include("meta", "data", "links");
      });
      test("Dataset Object Structure", () => { 
          const data = res.getBody().data[0];
          expect(data).to.have.property("type", "Dataset");
          expect(data).to.have.property("id");
          expect(data).to.have.property("attributes");
          expect(data).to.have.property("relationship");
          expect(data).to.have.property("meta");
      });
      test("Dataset type Validation", () => {      
          const name = res.getBody().data[0].type.name;
          expect(name).to.equal("Dataset");
      });
      test("Pagination Link Exists", () => {
          const links = res.getBody().links;
          expect(links).to.have.property("self");
      });
      if(jsonData){
      bru.setEnvVar("dataset_id_nds", jsonData.data[0].id);  
      }
      expect(responseBody).to.be.an('array').and.to.have.length.of.at.least(1);
        // Log the array content
      console.log("Array:", array);
    } else if (statusCode === 400) {
      // Assertions for 400 error (refer to previous section)
    } else if (statusCode === 401) {
      test("Unauthorized Error Message", () => {
        const data = res.getBody(); // Extract JSON data for 401 response
        expect(data).to.have.property("message", "Unauthorized");
      });
    } else if (statusCode === 404) {
      expect(responseBody).to.be.an('object').and.to.have.length.of.at.least(1);
      // Log the object content
      console.log("Object:", object);
      expect(data).to.have.property("message", "Not Found");
    } else {
      expect.fail("Unexpected status code: " + statusCode);
    }
  });
}

settings {
  encodeUrl: true
