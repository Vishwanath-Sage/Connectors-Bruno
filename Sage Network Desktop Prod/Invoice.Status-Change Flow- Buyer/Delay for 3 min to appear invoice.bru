meta {
  name: Delay for 3 min to appear invoice
  type: http
  seq: 1
}

get {
  url: https://postman-echo.com/get
  body: none
  auth: inherit
}

script:pre-request {
  
  
}

script:post-response {
  const delay = ms => new Promise(res => setTimeout(res, ms));
   
  (async () => {
      await delay(180000); // 60 seconds
      bru.setNextRequest("Get Invoice info Buyer");
  })();
}

settings {
  encodeUrl: true
}
