meta {
  name: Get Invoice info Seller
  type: http
  seq: 14
}

get {
  url: {{sageNetworkBaseUrl}}/api/v1/Invoices/query?order=modified desc
  body: none
  auth: inherit
}

params:query {
  order: modified desc
}

headers {
  accept: application/vnd.api+json
  X-Group-Key: {{networkProductInstancesTenantIdSeller}}
  Authorization: Bearer {{m2m_jwt_connector}}
}

script:post-response {
  test("Status code 200", function() {
      expect(res.getStatus()).to.equal(200);
  });
         
  test("Save SELLER invoiceId", function () {
      var jsonData = res.getBody();
  bru.setEnvVar("Seller_invoiceId", jsonData.records[0].invoiceId);
  });
  
  
}

settings {
  encodeUrl: true
}
