meta {
  name: 3. Update sync task
  type: http
  seq: 3
}

patch {
  url: {{connectorBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantIdSeller}}/sync-tasks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/vnd.api+json
  Accept: application/vnd.api+json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
      "data": {
          "type": "synctask",
          "id": "{{connectorSyncTaskId}}",
          "attributes": {
              "summary": {
                  "totalInvoices": 0,
                  "totalPayments": 0,
                  "totalCompanies": 0,
                  "totalContacts": 0,
                  "totalGlAccounts": 0,
                  "totalGlAccountEntries": 0,
                  "totalCustomFields": 0
              }
          },
          "relationships": {
              "attachment": {
                  "data": {
                      "id": "{{connectorAttachmentId}}",
                      "type": "attachment"
                  }
              }
          }
      }
  }
}

settings {
  encodeUrl: true
}
