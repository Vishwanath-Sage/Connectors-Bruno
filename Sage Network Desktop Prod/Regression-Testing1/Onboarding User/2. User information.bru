meta {
  name: 2. User information
  type: http
  seq: 1
}

get {
  url: {{sageIdURL}}/userinfo
  body: none
  auth: inherit
}

script:post-response {
  var jsonData = res.getBody();
  bru.setEnvVar("provisionAccountEmail", jsonData.email);
  bru.setVar("provisionAccountEmail", jsonData.email);
}

settings {
  encodeUrl: true
}
