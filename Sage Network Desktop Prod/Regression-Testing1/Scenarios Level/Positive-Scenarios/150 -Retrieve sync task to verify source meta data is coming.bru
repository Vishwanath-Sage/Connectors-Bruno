meta {
  name: 150 |Retrieve sync task to verify source meta data is coming
  type: http
  seq: 49
}

get {
  url: {{connectorBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantId}}/sync-tasks/{{connectorSyncTaskId}}?include=Details
  body: none
  auth: inherit
}

params:query {
  include: Details
}

headers {
  accept: application/vnd.api+json
}

script:post-response {
  test("Response status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Check for 'Completed' status", function () {
  
  var jsonData = res.getBody();
    console.log(1);
  const targetStatus = "Completed";
  //const responseStatus = jsonData.data.attributes.status;
  const responseStatus = jsonData.data.attributes.status;
  const maxRetries = 40;
  const retryInterval = 60000;
    
    
  function sleep(ms) {
    const start = Date.now();
    while (Date.now() - start < ms) {}
  }
  
  if (responseStatus != targetStatus) {
    console.log(2);
      if (bru.getEnvVar("retryCount") == undefined) {
          bru.setEnvVar("retryCount", 0);
        sleep(retryInterval);
        bru.setNextRequest(req.getName());
        console.log(3);
      } else {
          const retryCount = parseInt(bru.getEnvVar("retryCount"));
          bru.setEnvVar("retryCount", (retryCount + 1));
          if (retryCount < maxRetries) {
            console.log(4);
                 sleep(retryInterval);
                bru.setNextRequest(req.getName());
            
          } else {
              console.log("Max retries reached. Target status not reached.");
            console.log(5);
              bru.deleteEnvVar("retryCount");
  //  //           pm.execution.setNextRequest(null);
          }
      }
  }
          var responseData = res.getBody();
           expect(targetStatus).to.equal(responseData.data.attributes.status);
  });
  
  test("Verify meta source data are coming", function () {
  var jsonData = res.getBody();
    expect("2025.36.1").to.equal(jsonData.meta.source.sdkVersion)
    expect("3.14.1").to.equal(jsonData.meta.source.connectorVersion)
    expect("sage50.1.2.14").to.equal(jsonData.meta.source.productVersion)
  });
  
}

settings {
  encodeUrl: true
}
