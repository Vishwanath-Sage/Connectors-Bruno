meta {
  name: 10,19 |Create empty sync
  type: http
  seq: 1
}

post {
  url: {{connectorBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantId}}/sync-tasks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/vnd.api+json
  Accept: application/vnd.api+json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
      "data": {
          "type": "SyncTask",
          "attributes": {
              "packageType": "partial"
          }
      }
  }
}

script:post-response {
  test("Created", function(){
      expect(res.getStatus()).to.equal(201);
  })
}

settings {
  encodeUrl: true
}
