meta {
  name: 48| Create sync task to verify executable files only
  type: http
  seq: 41
}

post {
  url: {{connectorBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantId}}/sync-tasks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/vnd.api+json
  Accept: application/vnd.api+json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
      "data": {
          "type": "SyncTask",
          "attributes": {
              "packageType": "Full"
          }
      }
  }
}

script:post-response {
  test("Created", function(){
      expect(res.getStatus()).to.equal(201);
  })
  
  var jsonData = res.getBody();
  bru.setEnvVar("connectorSyncTaskId", jsonData.data.id);
  bru.setEnvVar("connectorBlobUploadUrl", 
          jsonData.included[0].attributes.uploadUrl);
  bru.setEnvVar("connectorAttachmentId", 
          jsonData.data.relationships.attachment.data.id);
  
  test("Response status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
}

settings {
  encodeUrl: true
}
