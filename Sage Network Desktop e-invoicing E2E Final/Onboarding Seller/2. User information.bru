meta {
  name: 2. User information
  type: http
  seq: 1
}

get {
  url: {{sageIdURL}}/userinfo
  body: none
  auth: inherit
}

script:post-response {
  var jsonData = res.getBody();
  bru.setEnvVar("provisionAccountEmailSeller", jsonData.email);
  bru.setVar("provisionAccountEmailSeller", jsonData.email);
  bru.setEnvVar("LoggedInUserAuth0PrincipalIdSeller", jsonData.sub)
  bru.setVar("LoggedInUserAuth0PrincipalIdSeller", jsonData.sub);
}

settings {
  encodeUrl: true
}
