meta {
  name: Query seller Details
  type: http
  seq: 1
}

get {
  url: {{sageNetworkBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantIdSeller}}/sync-tasks?take=20&skip=0
  body: none
  auth: inherit
}

params:query {
  take: 20
  skip: 0
}

headers {
  accept: application/vnd.api+json
  ~Authorization: Bearer {{m2m_jwt_connector}}
}

script:post-response {
  test("Response status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  var jsonData = res.getBody();
  bru.setEnvVar("SellerSyncTaskId", jsonData.data[0].id);
}

settings {
  encodeUrl: true
}
