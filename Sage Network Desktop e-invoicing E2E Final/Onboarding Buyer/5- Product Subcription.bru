meta {
  name: 5- Product Subcription
  type: http
  seq: 5
}

post {
  url: {{OrgServiceURL}}/v1/accounts/{{accountId}}/product-subscriptions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: {{provisionAccountIdempotency5}}
  Authorization: Bearer {{jwtCloudId}}
}

body:json {
  {
    "SubscriptionId": "{{SubscriptionIdBuyer}}",
    "Origin": "product",
    "BackOfficeId": "13922345",
    "BackOfficeSource": "InTouch"
  }
}

script:pre-request {
  // --- helper ---
  function makeUUID() {
    try {
      const { randomUUID } = require("crypto");
      return randomUUID();
    } catch {
      function s4() {
        return Math.floor((1 + Math.random()) * 0x10000).toString(16).substring(1);
      }
      return `${s4()}${s4()}-${s4()}-${s4()}-${s4()}-${s4()}${s4()}${s4()}`;
    }
  }
  
  // --- previous value (raw) ---
  const prev = bru.getVar("SubscriptionIdBuyer");
  
  // --- new value ---
  const next = makeUUID();
  
  // Set new values (runtime + env)
  bru.setVar("SubscriptionIdBuyer", next);
  bru.setEnvVar("SubscriptionIdBuyer", next);
  
  // --- Use bru.interpolate for logging or composing strings ---
  const logLine = bru.interpolate(
    "[SubscriptionIdBuyer] prev={{SubscriptionIdBuyer}} -> next={{SubscriptionIdBuyer}}"
  );
  // At this moment both prev/next equal (we just set it). If you want the *real* previous, use `prev` directly:
  console.log(`[SubscriptionIdBuyer] prev=${prev || "<none>"} -> next=${next}`);
  
  
  
  bru.setVar("provisionAccountIdempotency5", makeUUID()); // 
  bru.setEnvVar("provisionAccountIdempotency5", bru.getVar("idempotencyKey"));
  
}

script:post-response {
  const jsonData = res.getBody();
  
  if (!jsonData.errors) {
    bru.setVar("ProductSubscriptionIdBuyer", jsonData.Id);
  }
  
}

settings {
  encodeUrl: true
}
