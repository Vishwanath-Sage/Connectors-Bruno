meta {
  name: Get Create Action(Details)
  type: http
  seq: 2
}

get {
  url: {{sageNetworkBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantIdBuyer}}/sync-tasks/{{BuyerSyncTaskId}}?include=Details
  body: none
  auth: inherit
}

params:query {
  include: Details
}

headers {
  accept: application/vnd.api+json
  Authorization: Bearer {{m2m_jwt_connector}}
}

script:post-response {
  test("Response status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  var responseJSON = res.getBody();
  
  bru.setEnvVar("XMLAttachmentId", responseJSON.included[0].relationships.attachments.data[0].id);
  
  bru.setEnvVar("PDFAttachmentId", responseJSON.included[0].relationships.attachments.data[1].id);
  
  
}

settings {
  encodeUrl: true
}
