meta {
  name: query sync FromNetwork
  type: http
  seq: 1
}

get {
  url: {{sageNetworkBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantIdBuyer}}/sync-tasks?filter=operationtype eq 'fromNetwork'&take=3&skip=0
  body: none
  auth: inherit
}

params:query {
  filter: operationtype eq 'fromNetwork'
  take: 3
  skip: 0
  ~filter eq FromNetwork: null
}

headers {
  accept: application/vnd.api+json
  Authorization: {{bearer_token}}
}

script:post-response {
  var jsonData = res.getBody();
  bru.setEnvVar("fromNetworkSyncIdBuyer", jsonData.data[0].id);
}

settings {
  encodeUrl: true
}
