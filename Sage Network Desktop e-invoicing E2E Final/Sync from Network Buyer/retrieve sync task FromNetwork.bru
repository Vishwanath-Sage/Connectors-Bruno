meta {
  name: retrieve sync task FromNetwork
  type: http
  seq: 2
}

get {
  url: {{sageNetworkBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantIdBuyer}}/sync-tasks/{{fromNetworkSyncIdBuyer}}/?include=Details
  body: none
  auth: inherit
}

params:query {
  include: Details
}

script:post-response {
  var jsonData = res.getBody();
  bru.setEnvVar("attachmentId", jsonData.data.relationships.attachments.data[0].id);
}

settings {
  encodeUrl: true
}
