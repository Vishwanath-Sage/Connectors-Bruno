meta {
  name: Delay for 1 min to accept invoice
  type: http
  seq: 5
}

get {
  url: https://postman-echo.com/get
  body: none
  auth: inherit
}

script:pre-request {
  
  
}

script:post-response {
  const delay = ms => new Promise(res => setTimeout(res, ms));
   
  (async () => {
      await delay(60000); // 60 seconds
      bru.setNextRequest("Accept invoice-Buyer");
  })();
}

settings {
  encodeUrl: true
}
