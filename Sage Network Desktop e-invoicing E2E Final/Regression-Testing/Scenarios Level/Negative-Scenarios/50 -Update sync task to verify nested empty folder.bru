meta {
  name: 50 |Update sync task to verify nested empty folder
  type: http
  seq: 50
}

patch {
  url: {{connectorBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantId}}/sync-tasks?take=20&skip=0
  body: json
  auth: inherit
}

params:query {
  take: 20
  skip: 0
}

headers {
  Content-Type: application/vnd.api+json
  Accept: application/vnd.api+json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
      "data": {
          "type": "synctask",
          "id": "{{connectorSyncTaskId}}",
          "attributes": {
              "summary": {
                  "totalInvoices": 0,
                  "totalPayments": 0,
                  "totalCompanies": 0,
                  "totalContacts": 0,
                  "totalGlAccounts": 0,
                  "totalGlAccountEntries": 0,
                  "totalCustomFields": 0
              }
          },
          "relationships": {
              "attachment": {
                  "data": {
                      "id": "{{connectorAttachmentId}}",
                      "type": "attachment"
                  }
              }
          }
      }
  }
}

script:post-response {
  test("Response status code is 202", function () {
      expect(res.getStatus()).to.equal(202);
  });
  
  
  // // pm.test("Response time is less than 2000ms", function () {
  // //   pm.expect(pm.response.responseTime).to.be.below(20000);
  // });
  
}

settings {
  encodeUrl: true
}
