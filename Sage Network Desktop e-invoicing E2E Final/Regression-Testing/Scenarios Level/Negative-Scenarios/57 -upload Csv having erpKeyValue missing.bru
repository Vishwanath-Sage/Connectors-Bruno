meta {
  name: 57 |upload Csv having erpKeyValue missing
  type: http
  seq: 71
}

put {
  url: {{connectorBlobUploadUrl}}
  body: file
  auth: none
}

headers {
  Content-Type: application/vnd.api+json
  Accept: application/vnd.api+json
  x-ms-blob-type: BlockBlob
}

body:file {
  file: @file(C:\Users\Puja.Kumari2\Downloads\ERPAutomation 1\ERPAutomation\CSV_withoutERPKey.zip) @contentType(application/zip)
}

script:post-response {
