body:json {
  {
    "data": {
      "type": "Subscription",
      "attributes": {
        "scope": {
          "resource": "SyncTask",
          "eventType": "FromErpToDistribute",
          "datasetId": "6d36631e-3446-b575-41a0-7d1e719919de"
        },
        "data": {
          "feeds": [
            "AR Invoice"
          ]
        }
      }
    }
  }
}

script:post-response {
  test("Response status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  var jsonData = res.getBody();
  
  test("resource is equal SyncTask", function () {
      expect(jsonData.data.attributes.scope.resource).to.equal("SyncTask");
  });
  
  test("eventType is equal true", function () {
      expect(jsonData.data.attributes.scope.eventType).to.equal("FromErpToDistribute");
  });
  
  test("Dataset ID is not null and has size of 36 bits", function () {
      expect(jsonData.data.attributes.scope.datasetId).to.not.be.null;
      expect(jsonData.data.attributes.scope.datasetId).to.have.lengthOf(36);
  });
  
  test("feeds = AR Invoice", function () {
      expect(jsonData.data.attributes.data.feeds[0]).to.equal("AR Invoice");
  });
  
  test("id is not null and has size of 36 bit", function () {
      expect(jsonData.data.id).to.not.be.null;
     expect(jsonData.data.id).to.have.lengthOf(36);
  });
  
  test("type = Subscription", function () {
      expect(jsonData.data.type).to.equal("Subscription");
     
  });
  
  var today = new Date();
  var day = String(today.getDate()).padStart(2, '0');
  var month = String(today.getMonth() + 1).padStart(2, '0'); // January is 0!
  var year = today.getFullYear();
  var formattedDate = day + '/' + month + '/' + year;
  test("createdAt and modifiedAt include today's date", function () {
      expect(jsonData.meta.createdAt).to.include(year);
      expect(jsonData.meta.modifiedAt).to.include(year);
  });
  
  
  
  
  
  
}

