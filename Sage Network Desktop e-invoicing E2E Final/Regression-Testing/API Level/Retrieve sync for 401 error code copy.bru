meta {
  name: Retrieve sync for 401 error code copy
  type: http
  seq: 43
}

get {
  url: {{connectorBaseUrl}}/connectors/erp/datasets/{{networkProductInstancesTenantId}}/sync-tasks/{{connectorSyncTaskId}}?include=Details
  body: none
  auth: bearer
}

params:query {
  include: Details
}

headers {
  Accept: application/vnd.api+json
}

auth:bearer {
  token: eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6IkdoSWRxS2JCZld5UTNoeWs1Wmd3MiJ9..3wrKamH4KUPyxTxnB_6D2imBG8fLm6FKOQCDUpZ28FsusSj2a_jVUddHZzE5nFZdjtukrCNCWSnhYE7xLyvIWgIPqxWMxUDjqtjwXgfRAszvyiWHwEpJR1zu9vHIAVxvzOp1xHNviKzz-tAyJrNWvno3FEgTS1k_y7Ij979eTeuhrT_IE5VdkKFHzPdw1tXg3lFEeMx3eeRNDoxC3RQ4sDSs7arYTl96XbZWiad5z7Rf8lLOT86q-w23q6vZy-jXs9Vs0BOyW68enfP2DQhk6yO8blo4XBQF49pq_jHsN-pbOAypyL6fe7gcF7lup32iOObVTaCyv8tj-10IcvLL8w
