script:post-response {
  test("Response status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  var jsonData = res.getBody();
  
  test("Size of product ID is equal to 36", function () {
      const datasetid = jsonData.data[0].attributes.datasetId;
      expect(datasetid.length).to.equal(36);
  });
  
  test("Size of product ID is equal to 36", function () {
      const productId = jsonData.data[0].attributes.productId;
      expect(productId.length).to.equal(36);
  });
  
  test("productName field is not null and does not equal 'Unassigned'", function () {
      expect(jsonData.data[0].attributes.productName).to.not.be.null;
      expect(jsonData.data[0].attributes.productName).to.not.equal('Unassigned');
  });
  
  
  test("fullSyncCount is not null and partialSyncCount is not equal null", function () {
      expect(jsonData.data[0].attributes.fullSyncCount).to.not.be.null;
      expect(jsonData.data[0].attributes.partialSyncCount).to.not.be.null;
  });
  
  test("lastSeen field contains today's date", function () {
      var lastSeen = jsonData.data[0].attributes.lastSeen;
      var lastSeenDate = lastSeen.split('T')[0];
      var today = new Date().toISOString().split('T')[0];
      expect(lastSeenDate).to.equal(today);
  });
  
  test("licenseStatust is equal Active", function () {
      expect(jsonData.data[0].attributes.licenseStatus).to.equal("Active");
  });
  
  test("integrationMode is equal Live", function () {
      expect(jsonData.data[0].attributes.integrationMode).to.equal("Live");
  });
  
  test("createdAt field is not blank", function () {
      var createdAt = jsonData.data[0].meta.createdAt;
     
      expect(createdAt).to.not.be.null;
  });
  
  test("modifiedAt field contains today's date", function () {
      var modifiedAt = jsonData.data[0].meta.modifiedAt;
      var modifiedAtDate = modifiedAt.split('T')[0];
      var today = new Date().toISOString().split('T')[0];
      expect(modifiedAtDate).to.equal(today);
  });
  
  
  test("Size of ID is equal to 36", function () {
      const responseData = res.getBody();
      const id = responseData.data[0].id;
      expect(id.length).to.equal(36);
  });
  
  test("type = Dataset", function () {
      const responseData = res.getBody();
      const type = responseData.data[0].type;
      expect(type).to.equal("Dataset");
  });
  
  //Script for second dataset
  
  test("Size of product ID is equal to 36", function () {
      const datasetid = jsonData.data[1].attributes.datasetId;
      expect(datasetid.length).to.equal(36);
  });
  
  test("Size of product ID is equal to 36", function () {
      const productId = jsonData.data[1].attributes.productId;
      expect(productId.length).to.equal(36);
  });
  
  test("productName field is not null and does not equal 'Unassigned'", function () {
      expect(jsonData.data[1].attributes.productName).to.not.be.null;
      expect(jsonData.data[1].attributes.productName).to.not.equal('Unassigned');
  });
  
  
  test("fullSyncCount is not null and partialSyncCount is not equal null", function () {
      expect(jsonData.data[1].attributes.fullSyncCount).to.not.be.null;
      expect(jsonData.data[1].attributes.partialSyncCount).to.not.be.null;
  });
  
  test("lastSeen field contains today's date", function () {
      var lastSeen = jsonData.data[1].attributes.lastSeen;
      var lastSeenDate = lastSeen.split('T')[0];
      var today = new Date().toISOString().split('T')[0];
      expect(lastSeenDate).to.equal(today);
  });
  
  test("licenseStatust is equal Active", function () {
      expect(jsonData.data[1].attributes.licenseStatus).to.equal("Active");
  });
  
  test("integrationMode is equal Live", function () {
      expect(jsonData.data[1].attributes.integrationMode).to.equal("Live");
  });
  
  test("createdAt field is not blank", function () {
      var createdAt = jsonData.data[1].meta.createdAt;
     
      expect(createdAt).to.not.be.null;
  });
  
  test("modifiedAt field contains today's date", function () {
      var modifiedAt = jsonData.data[1].meta.modifiedAt;
      var modifiedAtDate = modifiedAt.split('T')[0];
      var today = new Date().toISOString().split('T')[0];
      expect(modifiedAtDate).to.equal(today);
  });
  
  
  test("Size of ID is equal to 36", function () {
      const responseData = res.getBody();
      const id = responseData.data[1].id;
      expect(id.length).to.equal(36);
  });
  
  test("type = Dataset", function () {
      const responseData = res.getBody();
      const type = responseData.data[1].type;
      expect(type).to.equal("Dataset");
  })
  
  
  
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
