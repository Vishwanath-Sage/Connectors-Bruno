meta {
  name: ADS (Buyer) Copy
  seq: 10
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: https://id-shadow.sage.com/oauth/token
  refresh_token_url: 
  client_id: {{client_id}}
  client_secret: {{client_secret}}
  scope: openid email profile offline_access user:full
  credentials_placement: basic_auth_header
  credentials_id: credentials
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}
