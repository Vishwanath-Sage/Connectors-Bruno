script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response includes access_token in environment", function () {
      var jsonData = res.getBody();
      bru.setGlobalEnvVar("sage_id_access_token", jsonData.access_token);
  });
}

settings {
  encodeUrl: true
}
