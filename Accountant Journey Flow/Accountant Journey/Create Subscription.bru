body:json {
  {
      "data": {
          "type": "Subscription",
          "attributes": {
              "scope": {
                  "resource": "SyncTask",
                  "eventType": "FromErpToDistribute",
                  "datasetId": "3e7970b1-67bf-c3ee-63df-00c4a3b099e4"
              },
              "data": {
                  "feeds": [
                      "AR Invoice"
                  ]
              }
          }
      }
  }
}

script:post-response {
  var jsonData = res.getBody();
  // Test to check if the status code of the response is 201
  test("Response status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  // Test to check if the resource in the response is equal to 'SyncTask'
  test("Resource in the response is 'SyncTask'", function () {
      expect(jsonData.data.type).to.equal('SyncTask');
  });
  var jsonData = res.getBody();
  
  // Test if the eventType in the response is equal to 'FromErpToDistribute'
  test("EventType in the response is 'FromErpToDistribute'", function () {
      expect(jsonData.data.attributes.scope.eventType).to.equal('FromErpToDistribute');
  });
  var jsonData = res.getBody();
  
  // Test to check if datasetId in the response is not null
  test("datasetId in the response is not null", function () {
      expect(jsonData.data.attributes.scope.datasetId).to.not.be.null;
  });
  var jsonData = res.getBody();
  
  // Test to check if the feeds list in the response is not null
  test("Feeds list in the response is not null", function () {
      expect(jsonData.data.attributes.data.feeds).to.not.be.null;
  });
  var jsonData = res.getBody();
  
  
  // Test the resource type in the response and check for additional attributes
  test("type is 'Subscription'", function () {
      expect(jsonData.data.type).to.equal('Subscription');
  });
  
  // Test if createdAt and modifiedAt in the response contain today's date
  test("createdAt and modifiedAt contain today's date", function () {
      const today = new Date().toISOString().split('T')[0]; // Format YYYY-MM-DD
      expect(jsonData.meta.createdAt).to.include(today);
      expect(jsonData.meta.modifiedAt).to.include(today);
  });
}

