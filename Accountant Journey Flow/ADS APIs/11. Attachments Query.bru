meta {
  name: 11. Attachments Query
  type: http
  seq: 7
}

get {
  url: {{ADSBaseURL}}/api/v1/Attachments/query
  body: none
  auth: bearer
}

headers {
  accept: application/json
  X-Group-Key: {{networkProductInstancesTenantId}}
}

