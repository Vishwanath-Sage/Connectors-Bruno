script:post-response {
  test("Response status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is less than 200ms", function () {
    expect(res.getResponseTime()).to.be.below(200);
  });
  
  test("Response has the required fields", function () {
      const responseData = res.getBody();
      
      expect(responseData).to.be.an('object');
      expect(responseData.totalCount).to.exist;
      expect(responseData.pageSize).to.exist;
      expect(responseData.records).to.exist;
  });
  
  test("TotalCount and PageSize should be non-negative integers", function () {
      const responseData = res.getBody();
      
      expect(responseData).to.be.an('object');
      expect(responseData.totalCount).to.be.a('number').and.to.be.at.least(0);
      expect(responseData.pageSize).to.be.a('number').and.to.be.at.least(0);
  });
  
  test("Records array is present and empty", function () {
      const responseData = res.getBody();
      
      expect(responseData).to.be.an('object');
      expect(responseData.records).to.exist.and.to.be.an('array').that.is.empty;
  });
  
  test("Number of Attachments matches Attachments uploaded in Sync.", function () {
      let response = res.getBody();
      let totalAttachmentsCount = response.totalCount;
      let expectedAttachmentsCount = bru.getVar("Attachments_updateCount");
  
      expect(expectedAttachmentsCount).to.eql(totalAttachmentsCount);
  });
}

settings {
  encodeUrl: true
}
