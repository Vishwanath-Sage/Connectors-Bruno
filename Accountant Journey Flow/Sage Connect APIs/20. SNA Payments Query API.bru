meta {
  name: 20. SNA Payments Query API
  type: http
  seq: 6
}

get {
  url: {{ADSBaseURL}}/api/v1/payments/query?filter=%28serviceFabricStatus+IS+NOT+NULL+OR+erpKey+IS+NULL%29+AND+isVoided+EQ+False&order=created+DESC&pageSize=20
  body: none
  auth: inherit
}

params:query {
  filter: %28serviceFabricStatus+IS+NOT+NULL+OR+erpKey+IS+NULL%29+AND+isVoided+EQ+False
  order: created+DESC
  pageSize: 20
}

script:post-response {
  test("Response status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  
  test("Response time is less than 200ms", function () {
    expect(res.getResponseTime()).to.be.below(2000);
  });
  
  
  test("Response has the required fields", function () {
      const responseData = res.getBody();
  
      expect(responseData).to.be.an('object');
      expect(responseData).to.have.property('totalCount');
      expect(responseData).to.have.property('pageSize');
      expect(responseData).to.have.property('records');
  });
  
  
  test("Total count and page size should be non-negative integers", function () {
      const responseData = res.getBody();
      
      expect(responseData.totalCount).to.be.a('number').and.to.be.at.least(0);
      expect(responseData.pageSize).to.be.a('number').and.to.be.at.least(0);
  });
  
  
  test("Records should be an empty array", function () {
      const responseData = res.getBody();
      
      expect(responseData).to.be.an('object');
      expect(responseData.records).to.be.an('array').that.is.empty;
  });
  
}

settings {
  encodeUrl: true
}
