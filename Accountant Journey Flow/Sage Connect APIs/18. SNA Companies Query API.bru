meta {
  name: 18. SNA Companies Query API
  type: http
  seq: 4
}

get {
  url: {{ADSBaseURL}}/api/v1/Companies/query?pageNumber=0&pageSize=1&filter=companyType+eq+Customer+and+isActive+eq+false
  body: none
  auth: inherit
}

params:query {
  pageNumber: 0
  pageSize: 1
  filter: companyType+eq+Customer+and+isActive+eq+false
}

script:post-response {
  test("Response status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  
  test("Response time is within acceptable range", function () {
    expect(res.getResponseTime()).to.be.below(500);
  });
  
  
