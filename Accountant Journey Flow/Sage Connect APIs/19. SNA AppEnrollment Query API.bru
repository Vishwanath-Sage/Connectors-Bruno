meta {
  name: 19. SNA AppEnrollment Query API
  type: http
  seq: 5
}

get {
  url: {{ADSBaseURL}}/api/v1/AppEnrollments/query?pageNumber=0&pageSize=1&order=created+desc&include=App%2C+LastSync
  body: none
  auth: inherit
}

params:query {
  pageNumber: 0
  pageSize: 1
  order: created+desc
  include: App%2C+LastSync
}

script:post-response {
  test("Response status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  
  test("Response time is less than 200ms", function () {
    expect(res.getResponseTime()).to.be.below(2000);
  });
  
  
  test("Response has the required fields", function () {
      const responseData = res.getBody();
      
      expect(responseData).to.be.an('object');
      expect(responseData.totalCount).to.exist;
      expect(responseData.pageSize).to.exist;
      expect(responseData.pageNumber).to.exist;
      expect(responseData.records).to.exist;
  });
  
  
  test("Validate totalCount, pageSize, and pageNumber are non-negative integers", function () {
      const responseData = res.getBody();
      
      expect(responseData.totalCount).to.be.a('number').and.to.be.at.least(0);
      expect(responseData.pageSize).to.be.a('number').and.to.be.at.least(0);
      expect(responseData.pageNumber).to.be.a('number').and.to.be.at.least(0);
  });
  
  
  test("Records is an array and is empty", function () {
    const responseData = res.getBody();
    
    expect(responseData).to.be.an('object');
    expect(responseData.records).to.be.an('array').that.is.empty;
  });
  
}

settings {
  encodeUrl: true
}
