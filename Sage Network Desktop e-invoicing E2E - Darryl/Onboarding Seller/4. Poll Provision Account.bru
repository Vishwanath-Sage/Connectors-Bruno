meta {
  name: 4. Poll Provision Account
  type: http
  seq: 3
}

post {
  url: {{connectedBridgeURL}}/provision/account
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: {{provisionAccountIdempotency}}
}

body:json {
  {
      "User": {
          "Email": "{{provisionAccountEmail}}",
          "FirstName": "{{$randomFirstName}}",
          "LastName": "{{$randomLastName}}",
          "Locale": "en-GB"
      },
      "Account": {},
      "ProductSubscription": {
          "ManagingAccountId": "{{provisionAccountManagingAccountId}}",
          "SubscriptionId": "{{provisionAccountSubscriptionId}}",
          "Origin": "{{origin}}",
          "BackOfficeId": "{{provisionAccountBackOfficeId}}",
          "BackOfficeSource": "{{STSProvider}}"
      },
  "ProductLicences": [{
      "Product": "{{productCode}}",
      "ProductLicenseType": "{{productLicenseType}}",
      "Expires": "2025-03-12 10:38:14Z"
      },
   {"Product": "network",
              "ProductLicenseType": "network-standard",
              "Expires": "2030-01-01T00:00:00+00:00"
      }],
      "Licence": {
              "Application": "{{STSApplication}}",
              "Version": "{{STSVersion}}",
              "Provider": "{{STSProvider}}",
              "LicenceData": "{{STSLicenseData}}"
      },
      "Business": {
          "Name": "{{provisionAccountName}}",
          "ExternalId": "{{provisionAccountExternalId}}",
          "ExternalSource": "Sage Desktop",
          "RegisteredLocation": "FR",
          "RegisteredCountry": "FR",
          "BusinessAddress": {
              "Type": "main",
              "Line1": "Sage",
              "Country": "FR"
          },
          "ProductInstance": {
              "Name": "{{productCode}}",
              "ProductCode": "{{productCode}}"
          }
     }  
  }
}

script:pre-request {
  let email = bru.getEnvVar("provisionAccountEmail");
  
  let networkProductInstancesTenantId = '750f6234-34d1-7a0f-39a4-2eebb7a7bc30';
  let stringToEncode = '{"TenantId":"' + networkProductInstancesTenantId + '","RoleIds":["erp"],"OwnerEmailHint":"' + email + '"}';
  bru.setEnvVar("contextHintEncoded", stringToBase32(stringToEncode));
  
  function stringToBase32(str) {
      var base32chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
      var binString = '';
      var pad = 0;
   
      for (var i = 0; i < str.length; i++) {
          var charCode = str.charCodeAt(i);
          var bits = charCode.toString(2);
          binString += leftpad(bits, 8, '0');
      }
   
      var base32String = '';
      for (var j = 0; j < binString.length; j += 5) {
          var chunk = binString.substr(j, 5);
          if (chunk.length < 5) {
              pad = 5 - chunk.length;
              chunk += '0'.repeat(pad);
          }
          var index = parseInt(chunk, 2);
          base32String += base32chars[index];
      }
   
      // Add padding if necessary
      if (pad > 0) {
          base32String += '='.repeat(pad);
      }
   
      return base32String;
  }
   
  function leftpad(str, len, pad) {
      return len + 1 >= str.length && (str = new Array(len + 1 - str.length).join(pad) + str), str;
  }
}

script:post-response {
  if (res.getStatus() === 202) {
      console.log("Continue to poll until 201 is returned");
  } else if (res.getStatus() === 201) {
      var jsonData = res.getBody();
      bru.setEnvVar("provisionAccountResponseAccountId", jsonData.AccountId);
      bru.setEnvVar("provisionAccountResponseUserId", jsonData.UserId);
      bru.setEnvVar("provisionAccountResponseBusinessId", jsonData.BusinessId);
   
      const networkProductInstances = jsonData.ProductInstances.find(p => p.ProductCode === 'network')
      const networkProductInstancesId = networkProductInstances ? networkProductInstances.Id : 'not found'
      bru.setEnvVar("networkProductInstancesId", networkProductInstancesId);
      const networkProductInstancesTenantId = networkProductInstances ? networkProductInstances.TenantId : 'not found'
      bru.setEnvVar("networkProductInstancesTenantId", networkProductInstancesTenantId);
      const networkProductInstancesProductCode = networkProductInstances ? networkProductInstances.ProductCode : 'not found'
      bru.setEnvVar("networkProductInstancesProductCode", networkProductInstancesProductCode);
   
      // Create encoded context for request 5. Shadow authorize. 
      let businessId = bru.getEnvVar("provisionAccountResponseBusinessId");
      let email = bru.getEnvVar("provisionAccountEmail");
   
      let stringToEncode = '{"TenantId":"' + networkProductInstancesTenantId + '","RoleIds":["erp"],"OwnerEmailHint":"' + email + '"}';
      bru.setEnvVar("contextHintEncoded", stringToBase32(stringToEncode));
  }
   
  function stringToBase32(str) {
      var base32chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
      var binString = '';
      var pad = 0;
   
      for (var i = 0; i < str.length; i++) {
          var charCode = str.charCodeAt(i);
          var bits = charCode.toString(2);
          binString += leftpad(bits, 8, '0');
      }
   
      var base32String = '';
      for (var j = 0; j < binString.length; j += 5) {
          var chunk = binString.substr(j, 5);
          if (chunk.length < 5) {
              pad = 5 - chunk.length;
              chunk += '0'.repeat(pad);
          }
          var index = parseInt(chunk, 2);
          base32String += base32chars[index];
      }
   
      // Add padding if necessary
      if (pad > 0) {
          base32String += '='.repeat(pad);
      }
   
      return base32String;
  }
   
  function leftpad(str, len, pad) {
      return len + 1 >= str.length && (str = new Array(len + 1 - str.length).join(pad) + str), str;
  }
}

settings {
  encodeUrl: true
}
